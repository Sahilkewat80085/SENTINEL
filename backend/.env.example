# Environment Configuration
ENVIRONMENT=development
LOG_LEVEL=INFO

# Database Configuration (PostgreSQL)
# For local Docker Compose, use database name, user, and password specified in compose
DATABASE_URL=postgresql+asyncpg://sentinel:sentinel_secure_pass@localhost:5432/sentinel_db
# In-Docker database URL
# DATABASE_URL=postgresql+asyncpg://sentinel:sentinel_secure_pass@db:5432/sentinel_db

# Redis & Celery Configuration
REDIS_URL=redis://localhost:6379/0
# In-Docker Redis URL
# REDIS_URL=redis://redis:6379/0

# GitHub Integration
# Personal Access Token with read/repo permissions
GITHUB_PAT=your_github_personal_access_token_here

# Security Settings
# Generate a secure random key using `openssl rand -hex 32`
JWT_SECRET=4f4f78328c0b78dfde89c36195c80a82b9921b7145e12f6da03e91122a2bb7f1
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Initial Admin Settings
ADMIN_USERNAME=admin
ADMIN_PASSWORD=sentinel_admin_password
